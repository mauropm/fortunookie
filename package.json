{
  "name": "fortune-cookie",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": "mauro parra <mauropm@gmail.com>",
  "type": "module",
  "description": "Fortune Cookie — A little luck for everyone. Crack a cookie, receive a positive fortune in 30 languages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:fortunes": "node scripts/generate-fortunes.mjs",
    "validate:fortunes": "node scripts/validate-fortunes.mjs",
    "report:fortunes": "node scripts/build-content-report.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
